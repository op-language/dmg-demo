// --- ROM (bank 0, 32KB, starts at 0x0000 to cover the vectors) ---------------

#[rom(org = 0x0000, bank = 0, maxsize = 0x8000)] {

    // real_main is a placement root (declared first in the rom block) so
    // it is placed right after main() at 0x0180. Everything is inlined
    // here (no function calls) so no stack pointer is needed.

    fn real_main() {
        di
        // Wait for vblank before turning the LCD off, so the off takes
        // effect cleanly at the frame boundary (the boot ROM leaves the
        // LCD on; writing VRAM while it is on is blocked in mode 3).
        do {
            ldh #LCD::LINE
            cp #144
        } while (not zero)
        ld #0
        ldh (LCD::CONTROL)
        ld #0
        ldh (LCD::SCROLL_Y)
        ld #0
        ldh (LCD::SCROLL_X)
        // Dummy reference so FONT_DATA is placed in ROM. The array
        // const's value resolves to its length, so the address cannot
        // be loaded directly; instead a 1-byte marker function is
        // placed immediately before the font data (see font_marker
        // below) and its address is used as the source pointer.
        ld #len!(FONT_DATA)
        // Load font: 4080 bytes from FONT_DATA to VRAM 0x8000.
        // ldi = LD (HL+),A so HL is the destination pointer, DE the source.
        // 4080 = 15*256 + 240.
        ld_de #font_marker
        inc_de
        ld_hl #0x8000
        ld #15
        ld_addr (cnt_b)
        do {
            ld #0
            ld_addr (cnt_a)
            do {
                ld_a_de
                ldi
                inc_de
                ld_a (cnt_a)
                dec
                ld_addr (cnt_a)
            } while (not zero)
            ld_a (cnt_b)
            dec
            ld_addr (cnt_b)
        } while (not zero)
        ld #240
        ld_addr (cnt_a)
        do {
            ld_a_de
            ldi
            inc_de
            ld_a (cnt_a)
            dec
            ld_addr (cnt_a)
        } while (not zero)
        // Write "Op Code!" at row 2, col 2 -> 0x9800 + 2*32 + 2 = 0x9842.
        ld_hl #0x9842
        ld #0x4F
        ldi
        ld #0x70
        ldi
        ld #0x20
        ldi
        ld #0x43
        ldi
        ld #0x6F
        ldi
        ld #0x64
        ldi
        ld #0x65
        ldi
        ld #0x21
        ldi
        // Background palette: 0xE4 -> color0=white(0), color3=black(3).
        // Font fg=0 (white), bg=3 (black) -> white text on black.
        ld #0xE4
        ldh (LCD::BG_PALETTE)
        // LCD on: bit7 display enable, bit4 tile data at 0x8000
        // (unsigned), bit0 BG enable -> 0x91.
        ld #0x91
        ldh (LCD::CONTROL)
        // Main loop: wait for vblank (LY == 144) then re-write the
        // tile map each frame so the text is always present regardless
        // of when the display is sampled.
        loop {
            do {
                ldh #LCD::LINE
                cp #144
            } while (not zero)
            ld_hl #0x9842
            ld #0x4F
            ldi
            ld #0x70
            ldi
            ld #0x20
            ldi
            ld #0x43
            ldi
            ld #0x6F
            ldi
            ld #0x64
            ldi
            ld #0x65
            ldi
            ld #0x21
            ldi
        }
    }

    // font_marker is an empty function: it compiles to a single RET
    // (0xC9). It is placed as the last function (declared last in the
    // rom block), and FONT_DATA is the only referenced const, so the
    // font data is emitted immediately after this byte. real_main uses
    // ld_de #font_marker / inc_de to point DE at the start of FONT_DATA.

    fn font_marker() {
    }
}

// --- GB cartridge header -----------------------------------------------------

#[gb(title = "DMG DEMO", cgb = "false", mbc = "rom")]

// --- RAM variables (GB work RAM at 0xC000) -------------------------------------

#[ram(org = 0xC000, maxsize = 0x100)] {
    cnt_a: u8;
    cnt_b: u8;
}

// --- Padding -------------------------------------------------------------------

#[setpad(0x00)]
