//! DMG Demo Game
//!
//! Displays the text "Op Code!" using the NES font. The std Game Boy
//! font functions rely on Z80-style load idioms the SM83 backend cannot
//! encode, so this demo loads the font and writes the tile map itself.
//!
//! The tile data is the std NES font (255 8x8 1bpp glyphs, char code =
//! tile index) expanded to GB 2bpp (plane 0 then plane 1 per row) for
//! fg=0, bg=3.

use std::cpu::*;
use std::machine::*;

