//! DMG Demo Game
//!
//! Displays the text "Op Code!" using the NES font via the std font
//! API (font_init, font_load, cls, draw_text).

use std::cpu::*;
use std::machine::*;
use std::font::*;

const HELLO: [u8; 8] = "Op Code!";

#[interrupt(reset)]
noreturn fn main() {
    di
    // Wait for vblank before touching the LCD (boot ROM leaves it on).
    do {
        ldh #LCD::LINE
        cp #144
    } while (not zero)
    system_initialize()
    font_init()
    set_text_color(3, 0)
    font_load(FONT_NES_SMALL_NORMAL)
    cls()
    draw_text(2, 2, HELLO, len!(HELLO))
    // DMG background palette: colour 0 = light, colour 3 = dark.
    ld #0xE4
    ldh (LCD::BG_PALETTE)
    // LCD on: 0x91 = display + 0x8000 tiles + BG enable.
    ld #0x91
    ldh (LCD::CONTROL)
    loop {
        do {
            ldh #LCD::LINE
            cp #144
        } while (not zero)
    }
}

#[interrupt(vblank)]
fn vblank() {
    reti
}

// define the structure of the cart
#[gb(title = "DMG DEMO", cgb = "false", mbc = "rom")]
#[rom(org = 0x0000, bank = 0, maxsize = 0x8000)]
#[ram(org = 0xC000, maxsize = 0x100)]
#[setpad(0x00)]
