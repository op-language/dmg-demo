    0xff,0xff,0xff,0xff,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x80,0x80,0xff,0xff,
    0xff,0xff,0xff,0xff,0x11,0x11,0x11,0x11,0x11,0x11,0x83,0x83,0xc7,0xc7,0xff,0xff,
    0xff,0xff,0xff,0xff,0x18,0x18,0x00,0x00,0x00,0x00,0x00,0x00,0x81,0x81,0xff,0xff,
    0xff,0xff,0xff,0xff,0x18,0x18,0x81,0x81,0xc3,0xc3,0x81,0x81,0x18,0x18,0xff,0xff,
    0xff,0xff,0xff,0xff,0x11,0x11,0x11,0x11,0x11,0x11,0x81,0x81,0xf1,0xf1,0x03,0x03,
    0xff,0xff,0xff,0xff,0x01,0x01,0x23,0x23,0xc7,0xc7,0x89,0x89,0x01,0x01,0xff,0xff,
    0xe1,0xe1,0xc7,0xc7,0xc7,0xc7,0x0f,0x0f,0xc7,0xc7,0xc7,0xc7,0xe1,0xe1,0xff,0xff,
    0xe3,0xe3,0xe3,0xe3,0xe3,0xe3,0xff,0xff,0xe3,0xe3,0xe3,0xe3,0xe3,0xe3,0xff,0xff,
    0x0f,0x0f,0xc7,0xc7,0xc7,0xc7,0xe1,0xe1,0xc7,0xc7,0xc7,0xc7,0x0f,0x0f,0xff,0xff,
    0x80,0x80,0x01,0x01,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,
];

// --- Reset entry -------------------------------------------------------------
//
// The GB cartridge header occupies 0x0100-0x017E (entry vector, logo,
// title, CGB/MBC/ROM-size/checksum bytes written by the linker/output).
// The vblank vector is at 0x0040. To keep executable code clear of both,
// main() is a 0x180-byte trampoline: a JP to real_main followed by 381
// NOPs. The header bytes overwrite NOPs in the trampoline (harmless;
// they are never executed). real_main lands at 0x0180.

#[interrupt(reset)]
noreturn fn main() {
    jp real_main
    nop
    nop
    nop
