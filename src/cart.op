//! DMG Demo Game
//!
//! This file is a port of the nes-demo to the Game Boy. It displays
//! the text "Op Code!" and cycles the four DMG monochrome background
//! palette shades.

use std::cpu::*;
use std::machine::*;
use std::font::*;

// --- vblank wait -----------------------------------------------------------

fn wait_vblank() {
    do {
        ldh #LCD::STATUS
        and #3
    } while (zero)
    do {
        ldh #LCD::STATUS
        and #3
    } while (not zero)
}

// --- palette animation -----------------------------------------------------

palcol: u8;

fn pal_animate() {
    ld_a (palcol)
    add #1
    and #3
    ld_addr (palcol)
    ldh (LCD::BG_PALETTE)
}

// --- main entry point ------------------------------------------------------

#[interrupt(reset)]
noreturn fn main() {
    system_initialize()
    font_init()
    set_text_color(0, 3)
    font_load(FONT_IBM_SMALL_NORMAL)
    cls()
    draw_text(2, 2, HELLO, len!(HELLO))
    ld #0
    ld_addr (palcol)
    ldh (LCD::BG_PALETTE)
    ld #LCD_BG_ENABLE
    ldh (LCD::CONTROL)
    loop {
        wait_vblank()
        pal_animate()
    }
}

// --- vblank interrupt handler ----------------------------------------------

#[interrupt(vblank)]
fn vblank() {
    reti
}

// --- string data -----------------------------------------------------------

const HELLO: [u8; 8] = "Op Code!";

// --- GB cartridge header ---------------------------------------------------

#[gb(title = "DMG DEMO", cgb = "false", mbc = "mbc3")]

// --- RAM variables (GB work RAM at 0xC000) ---------------------------------

#[ram(org = 0xC000, maxsize = 0x100)] {
}

// --- ROM (code in bank 0, 32KB) --------------------------------------------

#[rom(org = 0x0000, bank = 0, maxsize = 0x8000)] {
}

// --- padding ---------------------------------------------------------------

#[setpad(0x00)]
