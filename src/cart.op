//! DMG Demo Game
//!
//! Displays the text "Op Code!" using the NES font. The std Game Boy
//! font functions rely on Z80-style load idioms (ld h,#n, ld (hl),a,
//! ld a,(de), ld b,a) that the SM83 backend cannot encode, so this
//! demo loads the font and writes the tile map itself using only the
//! working SM83 subset (ld #n, ld_a (nn), ld_addr (nn), ldh #n, ldh
//! (n), ld_hl/ld_de/ld_bc #nn, ld_a_hl/ld_a_bc/ld_a_de, inc_hl/de/bc,
//! ldi=LD (HL+),A, dec, cp, jp, do/while/loop).
//!
//! The tile data is the std NES font (255 8x8 1bpp glyphs, char code
//! = tile index) expanded to the Game Boy 2bpp format (plane 0 then
//! plane 1 per row) for fg=0, bg=3.

use std::cpu::*;
use std::machine::*;

