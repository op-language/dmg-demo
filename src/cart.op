// --- ROM (bank 0, 32KB, starts at 0x0000 to cover the vectors) ---------------

#[rom(org = 0x0000, bank = 0, maxsize = 0x8000)] {

    fn real_main() {
        di
        // Wait for vblank before turning LCD off (boot ROM leaves it on).
        do {
            ldh #LCD::LINE
            cp #144
        } while (not zero)
        ld #0
        ldh (LCD::CONTROL)
        ld #0
        ldh (LCD::SCROLL_Y)
        ld #0
        ldh (LCD::SCROLL_X)
        // Dummy reference so FONT_DATA is placed in ROM.
        ld #len!(FONT_DATA)
        // Load font: 4080 bytes from FONT_DATA to VRAM 0x8000.
        // ldi = LD (HL+),A so HL is dest, DE is source.
        // 4080 = 15*256 + 240.
        ld_de #font_marker
        inc_de
        ld_hl #0x8000
        ld #15
        ld_addr (cnt_b)
        do {
            ld #0
            ld_addr (cnt_a)
            do {
                ld_a_de
                ldi
                inc_de
                ld_a (cnt_a)
                dec
                ld_addr (cnt_a)
            } while (not zero)
            ld_a (cnt_b)
            dec
            ld_addr (cnt_b)
        } while (not zero)
        ld #240
        ld_addr (cnt_a)
        do {
            ld_a_de
            ldi
            inc_de
            ld_a (cnt_a)
            dec
            ld_addr (cnt_a)
        } while (not zero)
        // Clear tile map (1024 bytes = 4*256) to tile 0.
        ld_hl #0x9800
        ld #4
        ld_addr (cnt_b)
        do {
            ld #0
            ld_addr (cnt_a)
            do {
                ld #0
                ldi
                ld_a (cnt_a)
                dec
                ld_addr (cnt_a)
            } while (not zero)
            ld_a (cnt_b)
            dec
            ld_addr (cnt_b)
        } while (not zero)
        // Write "Op Code!" at row 2, col 2 -> 0x9842.
        ld_hl #0x9842
        ld #0x4F
        ldi
        ld #0x70
        ldi
        ld #0x20
        ldi
        ld #0x43
        ldi
        ld #0x6F
        ldi
        ld #0x64
        ldi
        ld #0x65
        ldi
        ld #0x21
        ldi
        // Palette: BGP=0xE4 (color0=white, color3=black).
        ld #0xE4
        ldh (LCD::BG_PALETTE)
        // LCD on: 0x91 = display + 0x8000 tiles + BG enable.
        ld #0x91
        ldh (LCD::CONTROL)
        // Main loop: wait for vblank.
        loop {
            do {
                ldh #LCD::LINE
                cp #144
            } while (not zero)
        }
    }

    // font_marker: empty fn -> 1 byte (RET). Placed last; FONT_DATA
    // (the only referenced const) follows immediately. real_main uses
    // ld_de #font_marker / inc_de to point DE at &FONT_DATA.
    fn font_marker() {
    }
}

// --- GB cartridge header -----------------------------------------------------

#[gb(title = "DMG DEMO", cgb = "false", mbc = "rom")]

// --- RAM variables (GB work RAM at 0xC000) -------------------------------------

#[ram(org = 0xC000, maxsize = 0x100)] {
    cnt_a: u8;
    cnt_b: u8;
}

// --- Padding -------------------------------------------------------------------

#[setpad(0x00)]
