#[interrupt(vblank)]
fn vblank() {
    reti
}

#[gb(title = "DMG DEMO", cgb = "false", mbc = "rom")]

#[rom(org = 0x0000, bank = 0, maxsize = 0x8000)] {
    fn real_main() {
        di
        do {
            ldh #LCD::LINE
            cp #144
        } while (not zero)
        system_initialize()
        font_init()
        set_text_color(3, 0)
        font_load(FONT_NES_SMALL_NORMAL)
        cls()
        draw_text(2, 2, HELLO, len!(HELLO))
        ld #0xE4
        ldh (LCD::BG_PALETTE)
        ld #0x91
        ldh (LCD::CONTROL)
        loop {
            do {
                ldh #LCD::LINE
                cp #144
            } while (not zero)
        }
    }
}

#[ram(org = 0xC000, maxsize = 0x100)] {
}

#[setpad(0x00)]
